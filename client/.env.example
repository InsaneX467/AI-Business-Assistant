# Client Environment Variables Example
# Copy this file to client/.env if custom configuration is needed

# Base API URL pointing to the Express Node.js backend
VITE_API_BASE_URL=http://localhost:5000/api

# IMPORTANT SECURITY NOTE:
# NEVER place ADMIN_API_KEY or any secret tokens in VITE_* variables.
# All VITE_* environment variables are embedded into the client JS bundle.
