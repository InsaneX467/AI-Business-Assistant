# Server Environment Variables Example
# Copy this file to server/.env and fill in appropriate values

# Express Server Port
PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/ai_business_assistant

# Secret key required for Admin Lead Management endpoints (/api/leads)
ADMIN_API_KEY=your_admin_api_key_here

# Allowed CORS Origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Python FastAPI AI Service URL
LOCAL_AI_SERVICE_URL=http://127.0.0.1:8000/generate

# Selected AI Provider Router ("local", "gemini", or "offline_knowledge")
AI_PROVIDER=local

# Optional: Google Gemini API Key (only required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime Environment ("development" or "production")
NODE_ENV=development
