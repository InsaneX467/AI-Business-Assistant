# AI Business Assistant - Workspace Environment Example
# Copy appropriate sections into server/.env and client/.env

# ==============================================================================
# BACKEND SERVER CONFIGURATION (server/.env)
# ==============================================================================
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_business_assistant

# Secret Key for Admin Dashboard access (/api/leads)
ADMIN_API_KEY=your_admin_api_key_here

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Python FastAPI AI Service URL
LOCAL_AI_SERVICE_URL=http://127.0.0.1:8000/generate

# AI Provider Strategy: "local" (FastAPI Qwen), "gemini", or "offline_knowledge"
AI_PROVIDER=local

# Optional Gemini Fallback Key
GEMINI_API_KEY=

# Node Environment
NODE_ENV=development


# ==============================================================================
# FRONTEND CLIENT CONFIGURATION (client/.env)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:5000/api

# DO NOT put ADMIN_API_KEY here! Frontend bundle is exposed to users.
